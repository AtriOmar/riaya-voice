{
	"name": "riaya-realtime",
	"version": "1.0.0",
	"main": "dist/server.js",
	"license": "ISC",
	"description": "Riaya Realtime - Twilio phone call to Azure OpenAI Realtime API bridge for doctor appointment booking",
	"type": "module",
	"nodemonConfig": {
		"ignore": [
			"whatsapp-auth/**",
			"node_modules/**"
		]
	},
	"scripts": {
		"start": "tsc && node dist/server.js",
		"build": "tsc",
		"dev": "tsx watch src/server.ts --env-file=.env",
		"lint": "biome check --write",
		"format": "biome format --write",
		"fix:all": "biome check --write && biome format --write",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@azure/identity": "^4.11.1",
		"@biomejs/biome": "^2.4.10",
		"@hapi/boom": "^10.0.1",
		"@whiskeysockets/baileys": "7.0.0-rc13",
		"axios": "^1.7.9",
		"bullmq": "^6.3.2",
		"cors": "^2.8.5",
		"dotenv": "^17.2.2",
		"express": "^5.1.0",
		"ioredis": "^6.0.0",
		"pino": "^9.9.4",
		"pino-pretty": "^13.1.1",
		"qrcode": "^1.5.4",
		"twilio": "^6.0.0",
		"ws": "^8.18.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@whiskeysockets/baileys",
			"esbuild",
			"protobufjs",
			"sharp",
			"msgpackr-extract"
		]
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/node": "^24.3.1",
		"@types/qrcode": "^1.5.6",
		"@types/ws": "^8.18.1",
		"concurrently": "^9.2.1",
		"nodemon": "^3.1.10",
		"ts-node": "^10.9.2",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2"
	}
}
