# Server
PORT=8080
LOG_LEVEL=debug

# ── Required ────────────────────────────────────────────────

# Next.js app (REST API + public links, e.g. review URLs)
NEXTJS_API_URL=http://localhost:3000
# Internal auth between voice -> Next.js API (same value as the web app)
INTERNAL_API_SECRET=
# Public https address of the web app (same value as its NEXT_PUBLIC_APP_URL).
# Twilio calls <this>/api/calls/recording-webhook when a call recording is ready.
# Leave empty to turn call recording off.
WEB_PUBLIC_URL=
# Public hostname Twilio uses to open the media WebSocket (no path)
PUBLIC_SOCKET_HOST=

# OpenRouter: the location search model below, caller transcription, and the
# LiveKit agent's LLM/STT/TTS when those providers are set to openrouter/gemini/mai
OPENROUTER_API_KEY=
# Small model that writes the place searches (both scripts) and keeps the results that match
# LOCATION_SEARCH_MODEL=google/gemini-3.1-flash-lite

# Redis (BullMQ workers)
REDIS_URL=redis://localhost:6379

# Twilio. Use either the auth token or an API key pair (TWILIO_API_KEY_*).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# Riaya public number (E.164), used as From for outbound timeout callbacks
TWILIO_PHONE_NUMBER=
# true = refused/timeout callbacks ring an open /test-call page instead of Twilio (testing only)
CALLBACK_TO_TEST_CALL_PAGE=false

# Call routing for real Twilio calls:
#   gemini  = media stream -> realtime BACKEND below
#   livekit = SIP -> LiveKit agent (pnpm agent:dev)
CALL_ROUTER=gemini

# ── Realtime backend (CALL_ROUTER=gemini) ───────────────────

# gemini (default) | openai | gpt-live | inworld
BACKEND=gemini

# Gemini Live (BACKEND=gemini). Also used by the LiveKit agent when GEMINI_PROVIDER=google.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-live
# GEMINI_VOICE=Puck
# GEMINI_THINKING_LEVEL=

# Inworld Realtime (BACKEND=inworld). Also the default TTS of the LiveKit agent.
INWORLD_API_KEY=
# INWORLD_MODEL=google-ai-studio/gemini-3.1-flash-lite
# INWORLD_VOICE=Nour
# INWORLD_TTS_MODEL=inworld-tts-2

# OpenAI (BACKEND=openai or gpt-live, and TTS_PROVIDER=openai)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-realtime-1.5
# INPUT_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# GPT_LIVE_MODEL=
# GPT_LIVE_VOICE=marin
# GPT_LIVE_BACKEND_MODEL=
# GPT_LIVE_SETTLE_MS=1500

# Separate caller transcription on the phone stream: openrouter-chat | openrouter | off (use the realtime model transcript)
# CALLER_STT=
# CALLER_STT_MODEL=
# GEMINI_STT_REASONING=minimal

# ── LiveKit agent (CALL_ROUTER=livekit) ─────────────────────

# Fill from LiveKit Cloud -> Settings -> Keys / SIP. The web app needs the first three too.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# SIP host only, e.g. abc123.sip.livekit.cloud
LIVEKIT_SIP_HOST=
# Must match the LiveKit inbound trunk auth
LIVEKIT_SIP_USERNAME=
LIVEKIT_SIP_PASSWORD=
# LIVEKIT_AGENT_NAME=riaya-agent
# Where the agent sends dashboard events (defaults to this server's /agent-events)
# VOICE_EVENTS_URL=

# LLM: openrouter (default) | livekit (LiveKit Inference, uses LiveKit Cloud credits)
# LLM_PROVIDER=openrouter
# OPENROUTER_MODEL=openai/gpt-5.4-mini
# LIVEKIT_LLM_MODEL=openai/gpt-5.4-mini
# GEMINI_LLM_MODEL=google/gemini-2.5-flash
# GOOGLE_LLM_MODEL=gemini-2.5-flash

# Gemini API path for Gemini models: openrouter (default) | google (needs GEMINI_API_KEY)
# GEMINI_PROVIDER=openrouter

# Speech-to-text: mai (default, Microsoft MAI-Transcribe-2 via OpenRouter) | gemini | openrouter-gemini | google-gemini | whisper | inworld
# | any LiveKit Inference model (xai/stt-2, cartesia/ink-whisper, deepgram/nova-3, ...)
# STT_MODEL=mai
# GEMINI_STT_MODEL=google/gemini-3.8-flash
# GOOGLE_STT_MODEL=gemini-3.5-transcribe
# OPENROUTER_WHISPER_MODEL=
# STT_LANGUAGE_HINT=

# Text-to-speech: inworld (default) | openrouter | gemini | openai | inference
# TTS_PROVIDER=inworld
# OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
# OPENROUTER_TTS_VOICE=Charon
# GEMINI_OPENROUTER_TTS_MODEL=
# GEMINI_OPENROUTER_TTS_VOICE=Charon
# GOOGLE_TTS_MODEL=gemini-3.8-flash-lite-tts
# GOOGLE_TTS_VOICE=Charon
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_TTS_INSTRUCTIONS=
# TTS_INFERENCE_MODEL=xai/tts-1
# TTS_INFERENCE_VOICE=

# Name/language saving: background (default, a small model captures it) | tool (the conversation model calls update_person_info)
# PROFILE_CAPTURE=background
# PROFILE_EXTRACT_MODEL=openai/gpt-5.4-nano

# Turn-taking: stt (default, end-of-turn from STT) | vad (Silero silence, faster)
# TURN_DETECTION=stt
# ENDPOINTING_MIN_DELAY_MS=500

# ── Audio / call tuning (optional) ──────────────────────────

VAD_THRESHOLD=0.5
SILENCE_DURATION_MS=600
MAX_OUTPUT_TOKENS=4096
END_CALL_DELAY_MS=2500
# END_CALL_MAX_WAIT_MS=12000
NOISE_SUPPRESSION_ENABLED=true
NOISE_GATE_THRESHOLD=300

# Silent callers and call length: ask "are you still there?" after this much
# caller silence, then hang up after this much more. MAX_CALL_MS ends any call
# with a polite goodbye.
SILENCE_PROMPT_MS=12000
SILENCE_HANGUP_MS=10000
MAX_CALL_MS=900000
