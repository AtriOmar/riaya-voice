# Server
PORT=8080
LOG_LEVEL=debug

# Realtime backend: gemini (default) | openai | gpt-live | inworld
BACKEND=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-realtime-1.5
INPUT_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Next.js app (REST API + public links, e.g. review URLs)
NEXTJS_API_URL=http://localhost:3000

# Public hostname Twilio uses to open the media WebSocket (no path)
PUBLIC_SOCKET_HOST=

# Internal auth between voice -> Next.js API
INTERNAL_API_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Riaya public number (E.164) — From for outbound timeout callbacks
TWILIO_PHONE_NUMBER=
# true = refused/timeout callbacks ring an open /test-call page instead of Twilio (testing only)
CALLBACK_TO_TEST_CALL_PAGE=false

# Redis (BullMQ review worker)
REDIS_URL=redis://localhost:6379

# Geoapify
GEOAPIFY_API_KEY=

# Audio / VAD tuning (optional)
VAD_THRESHOLD=0.5
SILENCE_DURATION_MS=600
MAX_OUTPUT_TOKENS=4096
END_CALL_DELAY_MS=2500

# Silent callers and call length (optional)
# Ask "are you still there?" after this much caller silence, then hang up after
# this much more. MAX_CALL_MS ends any call with a polite goodbye.
SILENCE_PROMPT_MS=12000
SILENCE_HANGUP_MS=10000
MAX_CALL_MS=900000
NOISE_SUPPRESSION_ENABLED=true
NOISE_GATE_THRESHOLD=300
